# Không đặt mật khẩu/OTP Discord tại đây. Nhập trong form loopback.
# Cấu hình không bí mật. Chỉ nhập token và client secret trong giao diện cục bộ.
HOST=127.0.0.1
PORT=3210
PUBLIC_ORIGIN=http://127.0.0.1:3210
DATA_DIR=./data
RESTORE_SAVED_SESSIONS=1
# Khi mở qua LAN: cung cấp mật khẩu qua môi trường riêng và dùng HTTPS.
DASHBOARD_PASSWORD=
TLS_CERT_FILE=
TLS_KEY_FILE=
