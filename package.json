{
  "name": "discord-lyrics-status",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "launch": "node scripts/launch.mjs",
    "doctor": "node scripts/launch.mjs --check",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "package": "python3 scripts/package.py",
    "lab:login": "node scripts/login-lab.mjs",
    "smoke:login": "node scripts/login-smoke.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "discord.js": "^14.27.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.1",
    "@testing-library/react": "^16.3.3"
  }
}
